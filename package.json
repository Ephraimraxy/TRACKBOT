{
  "name": "trackbot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "prisma migrate deploy && tsx prisma/seed-admin.ts --if-configured && tsx prisma/seed-catalog.ts --if-requested && next start",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:catalog": "tsx prisma/seed-catalog.ts",
    "lint": "next lint",
    "test": "vitest run",
    "drill:migrations": "bash scripts/migration-drill.sh",
    "test:browser": "node tests/browser/p1-server.mjs && node tests/browser/p2-replay.mjs && node tests/browser/native-app.mjs && node tests/browser/payment-redirect.mjs && node tests/browser/map-race.mjs && node tests/browser/offline-queue.mjs && node tests/browser/webgl.mjs && node tests/browser/route-fallback.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.8.0",
    "@aws-sdk/client-s3": "^3.1157.0",
