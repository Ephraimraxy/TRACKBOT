# Copy this file to `.env` and fill in real values. `.env` is git-ignored; never commit secrets.

# --- Database -----------------------------------------------------------------
# Pooled/app connection and a direct connection (for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DATABASE_DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# --- Authentication (NextAuth) -------------------------------------------------
AUTH_SECRET="generate-with: npx auth secret"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Password given to seeded demo accounts (npx prisma db seed).
DEFAULT_PASSWORD="choose-a-demo-password"

# --- Chatbot AI providers ------------------------------------------------------
# Tried in this order: DeepSeek -> OpenAI -> Claude. Leave a key empty to disable that
# provider. With no key at all the chatbot still works using its built-in rule-based
# answers (real prices, stock and order status; no AI).
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides:
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-haiku-5-5
# Per-provider timeout before moving to the next one (milliseconds):
# CHAT_PROVIDER_TIMEOUT_MS=15000

# --- Image storage: Cloudflare R2 (product photos and avatars) ------------------
# Create an R2 bucket, then an API token with "Object Read & Write" for that bucket.
# Enable public access for the bucket (r2.dev URL or a custom domain) so browsers can show the photos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket, no trailing slash (e.g. https://pub-xxxxxxxx.r2.dev). Not a secret.
NEXT_PUBLIC_R2_PUBLIC_URL=

# --- Maps (optional) ---------------------------------------------------------------
# The 3D maps work with no account: free Esri satellite pictures plus OpenFreeMap/OpenStreetMap 3D buildings.
# A free Mapbox token (mapbox.com, Account > Tokens) gives sharper satellite pictures and deeper zoom.
# It is a public token, safe in the browser.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional extras for the maps:
#   NEXT_PUBLIC_MAPTILER_KEY  free plan at maptiler.com: another source of satellite pictures (used if no Mapbox token)
#   NEXT_PUBLIC_MAPILLARY_TOKEN  free client token at mapillary.com/dashboard/developers: street-level photos near the
#                                customer's spot and a street-photo layer on the map
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPILLARY_TOKEN=

# --- Email: Resend (verification and password-reset codes) ----------------------
RESEND_API_KEY=
# Sender address on a domain you verified in Resend, e.g. "TrackBot <no-reply@yourdomain.com>"
RESEND_FROM_EMAIL=

# --- Payments: Paystack (card, bank transfer, USSD, bank) -------------------------
# SECRET key from Paystack > Settings > API Keys. Server only: never commit it, never expose it to the browser.
# A key starting sk_test_ moves no real money; sk_live_ charges real cards and accounts.
PAYSTACK_SECRET_KEY=
# In Paystack > Settings > API Keys & Webhooks, set the webhook URL to:
#   https://<your-site>/api/payments/paystack/webhook
# Optional. The public address of this site (used for the return link after paying). Detected automatically when unset.
APP_URL=

# --- Accepted alternative names (so existing variables can be reused as they are) ---
#   JWT_SECRET       -> used when AUTH_SECRET is not set (prefer a NEW random secret for this app)
#   R2_BUCKET_NAME   -> used when R2_BUCKET is not set
#   R2_PUBLIC_URL    -> used when NEXT_PUBLIC_R2_PUBLIC_URL is not set
